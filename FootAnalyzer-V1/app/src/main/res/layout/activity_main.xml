<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible">


    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            tools:layout_editor_absoluteY="0dp"
            tools:ignore="MissingConstraints">


        <TextView
                android:id="@+id/title3"
                android:layout_width="134dp"
                android:layout_height="82dp"
                android:layout_marginStart="60dp"
                android:layout_marginTop="44dp"
                android:fontFamily="@font/centurygothic_bold"
                android:text="RUN"
                style="@style/textColor"
                android:textSize="60sp"
                android:textStyle="bold|italic"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/title4"
                android:layout_width="155dp"
                android:layout_height="85dp"
                android:fontFamily="@font/centurygothic"
                android:text="alyze"
                style="@style/textColor"
                android:textSize="60sp"
                app:layout_constraintStart_toEndOf="@id/title3"
                app:layout_constraintTop_toTopOf="@id/title3" />


        <ImageButton
                android:id="@+id/botonSeleccionarVideo"
                android:layout_width="116dp"
                android:layout_height="74dp"
                android:layout_marginBottom="200dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/seleccionar_video"
                android:scaleType="fitXY"
                android:visibility="visible"
                style="@style/botonCruz"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="MissingConstraints" />

        <ImageView
                android:id="@+id/pie_izquierdo"
                android:layout_width="126dp"
                android:layout_height="75dp"
                android:layout_marginStart="60dp"
                android:layout_marginTop="352dp"
                style="@style/pieInicioIzq"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <ImageView
                android:id="@+id/pie_derecho"
                android:layout_width="126dp"
                android:layout_height="75dp"
                android:layout_marginStart="228dp"
                android:layout_marginTop="352dp"
                style="@style/pieInicioDer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <Button
                android:id="@+id/boton_info"
                android:layout_width="197dp"
                android:layout_height="105dp"
                android:layout_marginBottom="56dp"
                android:text="¿En qué consiste un análisis del tipo de pisada?"
                style="@style/textosColores"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.502" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

